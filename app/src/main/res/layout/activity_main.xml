<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:map="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/mapContainerView"
        android:name="com.todokanai.busstop_seoul.components.fragment.MapFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        tools:layout="@layout/fragment_map" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/arriveInfoContainerView"
        android:name="com.todokanai.busstop_seoul.components.fragment.ArriveInfoFragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>